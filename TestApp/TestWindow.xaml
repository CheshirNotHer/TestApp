<Window x:Class="TestApp.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тест" Width="960" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid>

        <!-- ========== TEST VIEW ========== -->
        <Grid Visibility="{Binding IsFinished, Converter={StaticResource InvBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top bar: timer + progress -->
            <Border Grid.Row="0" Background="White" Padding="20,14"
                    BorderBrush="#E5E8EC" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding ProgressText}"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Right"
                            Background="#FFF3CD" CornerRadius="6" Padding="10,4"
                            Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " />
                            <TextBlock Text="{Binding TimeRemainingText}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- question -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,20,30,20" MaxWidth="820" HorizontalAlignment="Center">

                    <TextBlock Text="{Binding CurrentQuestion.Topic}"
                               Foreground="#6A7381" FontSize="12" Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding CurrentQuestion.QuestionText}"
                               TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <Image Source="{Binding CurrentQuestion.ImageSource}"
                           MaxWidth="560" MaxHeight="320"
                           HorizontalAlignment="Left" Margin="0,0,0,12"
                           Visibility="{Binding CurrentQuestion.HasImage, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OptionButton}"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectOptionCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Content>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap" FontSize="15"/>
                                    </Button.Content>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- explanation shown after answering -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="6" Padding="14" Margin="0,16,0,0"
                            Visibility="{Binding CurrentQuestion.IsExplanationVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Пояснение:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding CurrentQuestion.Explanation}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- navigation -->
            <Border Grid.Row="2" Background="White" Padding="20,12"
                    BorderBrush="#E5E8EC" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="← Назад"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,10,0"/>
                    <Button Content="Далее →"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsLastQuestion, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Content="Завершить"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding FinishCommand}"
                            Visibility="{Binding IsLastQuestion, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== RESULTS VIEW ========== -->
        <Grid Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top buttons -->
            <Border Grid.Row="0" Background="White" Padding="16,10"
                    BorderBrush="#E5E8EC" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Пройти ещё раз"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RetryCommand}" Margin="0,0,10,0"/>
                    <Button Content="В меню"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BackToMenuCommand}"/>
                </StackPanel>
            </Border>

            <!-- summary -->
            <Border Grid.Row="1" Background="White" Margin="20,16,20,8"
                    CornerRadius="10" Padding="20">
                <WrapPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,24,0"
                               Text="{Binding PercentText, StringFormat='Результат: {0}'}"/>
                    <TextBlock Margin="0,0,20,0">Всего: <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                    <TextBlock Margin="0,0,20,0" Foreground="#2EA85B">
                        Правильно: <Run Text="{Binding CorrectCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,20,0" Foreground="#DE3B45">
                        Неправильно: <Run Text="{Binding IncorrectCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Foreground="#6A7381">
                        Без ответа: <Run Text="{Binding UnansweredCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </WrapPanel>
            </Border>

            <!-- detailed results -->
            <ListBox Grid.Row="2" ItemsSource="{Binding Questions}"
                     Background="Transparent" BorderThickness="0"
                     Margin="16,0,16,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8"
                                Padding="18" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Number, StringFormat='Вопрос {0}'}"
                                               FontWeight="Bold" Foreground="#6A7381"/>
                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E5E8EC"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Correct">
                                                        <Setter Property="Background" Value="#D8F3DE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Incorrect">
                                                        <Setter Property="Background" Value="#FBDDDF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AnswerStatusDisplay}" FontSize="12"/>
                                    </Border>
                                </DockPanel>

                                <TextBlock Text="{Binding Topic}"
                                           FontSize="11" Foreground="#8A93A1"
                                           Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding QuestionText}"
                                           TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <Image Source="{Binding ImageSource}"
                                       MaxWidth="400" MaxHeight="240"
                                       HorizontalAlignment="Left" Margin="0,0,0,8"
                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="10,6" Margin="0,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Correct">
                                                                <Setter Property="Background" Value="#D8F3DE"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Wrong">
                                                                <Setter Property="Background" Value="#FBDDDF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="RevealCorrect">
                                                                <Setter Property="Background" Value="#E8F7EC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#F5F7FA" CornerRadius="4"
                                        Padding="10" Margin="0,8,0,0"
                                        Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Пояснение:" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding Explanation}"
                                                   TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- bottom buttons -->
            <Border Grid.Row="3" Background="White" Padding="16,10"
                    BorderBrush="#E5E8EC" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Пройти ещё раз"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RetryCommand}" Margin="0,0,10,0"/>
                    <Button Content="В меню"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BackToMenuCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>