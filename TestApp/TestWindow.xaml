<Window x:Class="TestApp.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Прохождение теста" Width="980" Height="750"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource BgColor}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Кастомный заголовок окна -->
        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock Text="Прохождение теста" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Свернуть">
                    <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Развернуть">
                    <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Закрыть">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Обертка для всего контента -->
        <Grid Grid.Row="1">
            <!-- ========== ЭКРАН ТЕСТА ========== -->
            <Grid Visibility="{Binding IsFinished, Converter={StaticResource InvBoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель -->
                <Border Grid.Row="0" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid Margin="30,16">
                        <TextBlock Text="{Binding ProgressText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextMain}"/>

                        <!-- Таймер -->
                        <Border HorizontalAlignment="Right" Background="{DynamicResource TimerBg}" CornerRadius="20" Padding="14,6"
                                Visibility="{Binding IsTimed, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " FontSize="14" Foreground="{DynamicResource TimerText}"/>
                                <TextBlock Text="{Binding TimeRemainingText}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TimerText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Основной контент (Вопросы) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,30,40,30" MaxWidth="820" HorizontalAlignment="Center">

                        <TextBlock Text="{Binding CurrentQuestion.Topic}" Foreground="{DynamicResource PrimaryColor}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding CurrentQuestion.QuestionText}" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" Foreground="{DynamicResource TextMain}"/>

                        <Image Source="{Binding CurrentQuestion.ImageSource}" MaxWidth="500" MaxHeight="300" HorizontalAlignment="Left" Margin="0,0,0,16" 
                               Visibility="{Binding CurrentQuestion.HasImage, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding CurrentQuestion.Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource OptionButton}" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.SelectOptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Пояснение (во время теста) -->
                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,24,0,0"
                                Visibility="{Binding CurrentQuestion.IsExplanationVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="💡 Пояснение" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryColor}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding CurrentQuestion.Explanation}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Нижняя панель (Навигация) -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="30,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="← Назад" Style="{StaticResource SecondaryButton}" Command="{Binding BackCommand}" 
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0"/>

                        <Button Content="Далее →" Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" 
                                Visibility="{Binding IsLastQuestion, Converter={StaticResource InvBoolToVis}}"/>

                        <Button Content="Завершить" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" 
                                Visibility="{Binding IsLastQuestion, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========== ЭКРАН РЕЗУЛЬТАТОВ ========== -->
            <Grid Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

              

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30,24">

                        <!-- Блок с оценкой -->
                        <Border Background="{DynamicResource CardBg}" CornerRadius="12" Padding="30" Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Круг с процентом -->
                                <Grid Grid.Column="0" Width="120" Height="120">
                                    <Ellipse Fill="{DynamicResource BgColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="8"/>
                                    <TextBlock Text="{Binding PercentText}" FontSize="24" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}"/>
                                </Grid>

                                <!-- Статистика -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0">
                                    <TextBlock Text="Результаты теста" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource TextMain}"/>
                                    <WrapPanel>
                                        <TextBlock FontSize="16" Margin="0,0,30,0" Foreground="{DynamicResource TextMuted}">
                                            Всего: <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="16" Margin="0,0,30,0" Foreground="{DynamicResource SuccessColor}">
                                            Верно: <Run Text="{Binding CorrectCount, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="16" Margin="0,0,30,0" Foreground="{DynamicResource ErrorColor}">
                                            Ошибки: <Run Text="{Binding IncorrectCount, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="16" Foreground="{DynamicResource TextMuted}">
                                            Без ответа: <Run Text="{Binding UnansweredCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextMain}"/>
                                        </TextBlock>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Детальный разбор" FontSize="20" FontWeight="SemiBold" Margin="0,30,0,16" Foreground="{DynamicResource TextMain}"/>

                        <!-- Список вопросов -->
                        <ItemsControl ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBg}" CornerRadius="10" Padding="24" Margin="0,0,0,16" Effect="{StaticResource CardShadow}">
                                        <StackPanel>
                                            <!-- Заголовок карточки -->
                                            <DockPanel Margin="0,0,0,12">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number, StringFormat='Вопрос {0}'}" 
                                                           FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>

                                                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="10,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource BgColor}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Correct">
                                                                    <Setter Property="Background" Value="{DynamicResource SuccessBg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Incorrect">
                                                                    <Setter Property="Background" Value="{DynamicResource ErrorBg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding AnswerStatusDisplay}" FontSize="13" FontWeight="SemiBold"/>
                                                </Border>
                                            </DockPanel>

                                            <!-- Контент вопроса -->
                                            <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{DynamicResource TextMain}"/>

                                            <Image Source="{Binding ImageSource}" MaxWidth="400" MaxHeight="250" HorizontalAlignment="Left" Margin="0,0,0,12"
                                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>

                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6" Padding="12,8" Margin="0,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding State}" Value="Correct">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Wrong">
                                                                            <Setter Property="Background" Value="{DynamicResource ErrorBg}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="RevealCorrect">
                                                                            <Setter Property="Background" Value="{DynamicResource SuccessBg}"/>
                                                                            <Setter Property="Opacity" Value="0.7"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Пояснение (в результатах) -->
                                            <Border Background="{DynamicResource BgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                                                    Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="Пояснение:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextMain}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Нижняя панель (кнопки в конце) -->
                <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="30,16">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Пройти ещё раз" Style="{StaticResource PrimaryButton}" Command="{Binding RetryCommand}" Margin="0,0,12,0"/>
                        <Button Content="В меню" Style="{StaticResource SecondaryButton}" Command="{Binding BackToMenuCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>