<Window x:Class="TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тестирование" Width="820" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Тестирование по курсу" FontSize="26" FontWeight="Bold" Foreground="#1B2431"/>
            <TextBlock Text="{Binding QuestionCountText}" Foreground="#6A7381" Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" MaxWidth="640" HorizontalAlignment="Left">

            <Button Content="1. Пройти все вопросы"
                    Style="{StaticResource PrimaryButton}"
                    Click="All_Click" Margin="0,0,0,10"/>

            <Button Content="{Binding UniformButtonText}"
        Style="{StaticResource SecondaryButton}"
        Click="Uniform_Click" Margin="0,0,0,10"/>

            <Button Content="{Binding RandomButtonText}"
        Style="{StaticResource SecondaryButton}"
        Click="Random_Click" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{Binding TimedButtonText}"
        Style="{StaticResource SecondaryButton}"
        Click="Timed_Click"/>
                <TextBlock Text="{Binding TimedMinutesText}"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="#6A7381"/>
            </StackPanel>

            <Separator Margin="0,10,0,10"/>

            <TextBlock Text="5. Пройти все вопросы по выбранной теме:"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Topics}"
                          SelectedItem="{Binding SelectedTopic}"
                          Width="360" Height="34" FontSize="14" Padding="6,4"/>
                <Button Content="Начать тест по теме" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="ByTopic_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,24,0,0">
            <Button Content="⚙ Настройки" Style="{StaticResource SecondaryButton}"
                    Click="Settings_Click"/>
        </StackPanel>
    </Grid>
</Window>