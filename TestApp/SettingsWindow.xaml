<Window x:Class="TestApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Width="450" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Время теста с таймером (минуты):" Margin="0,0,0,6"/>
            <TextBox Text="{Binding TimedTestMinutes, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="6,4" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <TextBlock Text="Количество вопросов (для режимов 2, 3 и 4):" Margin="0,0,0,6"/>
            <TextBox Text="{Binding TestQuestionCount, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="6,4" Width="120" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <CheckBox Content="Перемешивать варианты ответов" 
                      IsChecked="{Binding ShuffleAnswers}"
                      FontSize="14" Margin="0,0,0,10"/>

            <CheckBox Content="Показывать пояснение сразу после ответа" 
                      IsChecked="{Binding ShowExplanationImmediately}"
                      FontSize="14" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                    Click="Cancel_Click" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>